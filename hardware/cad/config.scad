// =====================================================================
// 루틴 디스펜서 v2 (8칸: 가루 4 + 알약 4) · 공통 치수
// ---------------------------------------------------------------------
// 모든 부품 파일이 이 파일을 include 합니다. 숫자는 여기서만 고치세요.
// ★ = 추정치. 부품이 도착하면 측정표대로 재서 바꿉니다.
// 좌표: X 왼→오, Y 앞→뒤, Z 아래→위 (mm). 원점은 두 스테이션 사이, 바닥판 윗면 높이.
// 왼쪽 = 가루 스테이션, 오른쪽 = 알약 스테이션
// =====================================================================

$fn = 48;

// ---- 프린터 공차 (공차 쿠폰으로 확정) --------------------------------
clear      = 0.3;    // 끼워 맞춤 한쪽 여유 (쿠폰 C줄 3번으로 확정)
byj_d_clear = 0.15;  // 28BYJ 축 ↔ 원판 D구멍 여유 (쿠폰 B줄 4번으로 확정)
jga_d_clear = 0.15;  // ★ JGA 축 ↔ 스크류 허브 D구멍 여유 (쿠폰 J줄, 모터 오면 확정)
m3_hole    = 3.4;    // ★ M3 나사가 헐겁게 지나가는 구멍
m3_nut_af  = 5.8;    // ★ M3 너트 맞변 거리 + 여유 (육각 주머니)
m3_nut_t   = 2.7;    // ★ M3 너트 두께 + 여유
m3_head_d  = 6.2;    // 렌치볼트 머리 지름 + 여유
auger_gap  = 0.5;    // 스크류 날개 ↔ 관 벽 한쪽 틈. 스크류 지름만 바뀜 (관 16 고정)
                     // 좁히면 덜 새지만 가루가 끼어 모터가 멈출 수 있음. 가루 시험 전엔 0.5 유지

// ---- 나사 대신 쓰는 것 ------------------------------------------------
// 핀: 출력한 작은 원기둥. 구멍에 떨어뜨려 넣고 부품을 얹으면 자리가 잡힘 (무게로 눌림)
pin_d   = 4;
pin_len = 6.5;
pin_hole = pin_d + 2*clear;
// 기둥 끝 네모 돌기: 바닥판·상판의 네모 구멍에 끼움
peg_w = 6;  peg_h = 4;
peg_hole = peg_w + 2*clear;

// ---- 가루 모터: JGA25-370 6V 77RPM (상품 치수도 기준) ------------------
jga_gear_d    = 25;    // 감속기 지름 (치수도)
jga_gear_len  = 23;    // 감속기 길이 — 77RPM 은 23 (치수도 표)
jga_motor_d   = 24.4;  // 모터 몸통 지름 (치수도)
jga_motor_len = 30.8;  // 모터 몸통 길이 (치수도)
jga_term_len  = 4;     // 뒤쪽 단자 (치수도)
jga_shaft_d   = 4;     // 축 지름 (치수도)
jga_shaft_flat= 3.5;   // 축 D컷 (치수도)
jga_shaft_len = 11.5;  // 감속기 앞면 → 축 끝 (치수도)
jga_boss_d    = 7;     // 앞면 돌기 (치수도)
jga_boss_h    = 2.5;   // (치수도)
jga_len       = jga_gear_len + jga_motor_len + jga_term_len;

// ---- 알약 모터: 28BYJ-48 --------------------------------------------
// 출처: 제조사 도면 (components101 28BYJ-48 dimensions) + 사용자 실측 (2026-10-04)
byj_body_d    = 28;    // 도면 Ø28
byj_body_h    = 19.4;  // 실측 19.4 (도면 19)
byj_ear_span  = 35;    // 도면 35±0.2, 실측 (안쪽 벽 + 바깥쪽 벽) / 2 로 확인
byj_ear_hole  = 4.2;   // 도면 Ø4.2
byj_shaft_off = 8;     // 도면: 몸통 중심 → 축 8
byj_shaft_d   = 5;     // 도면 Ø5
byj_shaft_flat= 3;     // 도면: 양쪽 D컷 폭 3
byj_shaft_len = 8.5;   // 도면: 몸통 윗면 → 축 끝 10, 돌기 1.5 → 돌기 윗면에서 8.5
byj_flat_len  = 6;     // 도면: D컷 길이 6 (축 끝에서부터). 그 아래는 둥근 축
byj_ear_t     = 0.8;   // 고정 귀 두께 (도면에 없음, 설계에서 안 씀)
byj_boss_d    = 9;     // 도면 Ø9
byj_boss_h    = 1.5;   // 도면 1.5
byj_cover_w   = 14.6;  // 도면: 파란 전선 덮개 폭
byj_cover_r   = 17;    // 도면: 몸통 중심 → 덮개 끝 17 (실측: 몸통 밖으로 3)
byj_conn_w    = 15;    // 실측: 흰색 커넥터(JST XH 5핀) 폭
byj_conn_t    = 5.5;   // 실측: 두께
byj_conn_l    = 8;     // 실측: 길이 (전선 방향)

// ---- 로드셀 1kg (VLT-LCS002, 상품 치수도 기준) ------------------------
lc_l      = 80;        // 치수도
lc_w      = 12.7;      // 치수도
lc_h      = 12.7;      // 치수도
lc_holes  = [5, 20];   // 양 끝에서 구멍까지 (치수도: 15 간격, 안쪽 40 간격)
// 전선이 나오는 끝 = M5 두 개 = 고정 끝(받침). 반대 끝 = M4 두 개 = 쟁반.
lc_fix_bolt_d  = 5.5;  lc_fix_head_d  = 9.2;  lc_fix_head_h  = 5.8;   // M5x15 (머리 자리 천장이 처져도 머리가 안 튀어나오게 0.8 여유)
lc_load_bolt_d = 4.5;  lc_load_head_d = 7.6;  lc_load_head_h = 4.2;   // M4x12

// ---- 컵 (다이소, 미정) ------------------------------------------------
cup_bottom_d = 55;     // ★ 바닥 지름
cup_top_d    = 75;     // ★ 입구 지름 (가루 출구 4개가 이 안에 떨어져야 함)
cup_h        = 75;     // ★ 높이
function cup_d_at(h) = cup_bottom_d + (cup_top_d - cup_bottom_d) * h / cup_h;

// ---- 알약 -------------------------------------------------------------
// 최대 알약: 모듈 몸체(치마·바닥·덮개·알약 상판 미끄럼관)를 이 크기로 만듦. 한 번만 뽑음.
pill_max_l = 26;       // ★ 오메가3 1000mg 연질캡슐급 (흔히 약 25 × 10~11)보다 조금 크게
pill_max_w = 11;       // ★
pill_max_t = 11;       // ★ 연질캡슐은 단면이 둥글어서 두께 = 폭
// 칸에 넣을 알약: 원판 칸·원판 두께·받침판을 이 크기로 만듦. 알약을 바꾸면 원판·받침판만 다시 뽑음.
pill_l = 18.2;         // 실측: 종근당 멀티비타민 길이
pill_w = 9.2;          // 실측: 폭
pill_t = 5.9;          // 실측: 누웠을 때 두께

// ---- 전자부품 ----------------------------------------------------------
pb_w = 89;  pb_d = 52; pb_t = 1.6;       // 만능기판 (상품명 치수) · 두께 ★
esp_w = 54.4; esp_d = 27.9; esp_t = 1.6; // ★ ESP32-DevKitC V4
dcj_d = 11;  dcj_l = 30;                 // ★ DC 잭 몸통 지름·길이
uln_w = 35;  uln_d = 33; uln_t = 1.6;    // ULN2003 보드 (상품 설명 35×33) · 두께 ★
mcp_w = 55;  mcp_d = 32; mcp_t = 1.6;    // ★ MCP23017 보드
hx_w  = 35;  hx_d  = 21; hx_t  = 1.6;    // ★ HX711 보드
hall_w = 4.2; hall_l = 3.2; hall_t = 1.6; // ★ 49E 홀 센서 알맹이 (TO-92S). KY-035 보드에서 떼어 다리에 단선 납땜
mag_d = 8;   mag_t = 3;                  // 원판 원점 자석 (ND 8Ø×3t)

// ---- 뼈대 (스테이션마다 바닥판 + 상판 + 기둥) ------------------------
base_t   = 6;          // 바닥판 두께 (아랫면에 너트 주머니)
deck_t   = 5;          // 상판 두께
deck_z   = 120;        // 상판 아랫면 높이
deck_top = deck_z + deck_t;
rim_h    = 6;          // 상판 테두리 (아래로)
rim_w    = 3;
post_w   = 14;

cupP  = [-110, 0];     // 가루 스테이션 중심 = 가루 컵 중심
cupL  = [ 105, 0];     // 알약 스테이션 중심 = 알약 컵 중심
sizeP = [210, 210];    // 가루 스테이션 판 크기
sizeL = [205, 205];    // 알약 스테이션 판 크기
// 기둥: 모듈 발판·모터 아래를 피하고, 앞쪽(-Y)은 컵을 꺼내는 길이라 비움
postsP = [for (p = [[-93,-45],[93,-45],[-93,45],[93,45],[-93,0],[93,0],[0,93]]) [cupP[0]+p[0], cupP[1]+p[1]]];
postsL = [for (p = [[-92,-92],[92,-92],[-92,92],[92,92],[-92,0],[92,0],[0,92]]) [cupL[0]+p[0], cupL[1]+p[1]]];
ctrl_c    = [cupL[0], cupL[1] + sizeL[1]/2 + 50];   // 제어함 (알약 스테이션 뒤, 탁자 위)
ctrl_size = [190, 90];

// ---- 배치 --------------------------------------------------------------
powder_d   = 13;                 // 컵 중심 → 가루 모듈 출구 끝면
powder_a   = [45, 135, 225, 315];// 가루 모듈 방향 (X자)
pill_s     = 51;                // 알약 모듈 중심의 X·Y 거리 (2×2)

// ---- 출력 영역 (Ender-3 SE) ------------------------------------------
bed = [220, 220, 250];
